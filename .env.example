# Bu fayl repozitoriyada saqlanadi va faqat KALIT NOMLARI bilan placeholderlarni
# o'z ichiga oladi. Haqiqiy qiymatlar faqat .env da bo'ladi (.gitignore da).
#
#   cp .env.example .env
#
# Yangi o'zgaruvchi qo'shsangiz, uni SHU FAYLGA ham qo'shing — `make doctor` va CI
# ikkalasining kalitlari mos kelishini tekshiradi.

# ---------------------------------------------------------------- Ilova
APP_NAME=project
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=debug

# ---------------------------------------------------------------- Docker Compose
# docker-compose.yml shu qiymatlarni o'qiydi
COMPOSE_PROJECT_NAME=project
POSTGRES_DB=app_db
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------- Database
# Host mashinadan (lokal `npm run dev`, migration, psql):
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/app_db
# Container ichidan ishlaganda host nomi `localhost` emas, `postgres` bo'ladi:
# DATABASE_URL=postgresql://app:app_dev_password@postgres:5432/app_db

# ---------------------------------------------------------------- Queue / Cache
# `make dev-queue` bilan ko'tariladi. Container ichidan: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Xavfsizlik
# Yaratish: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Vergul bilan ajratilgan ruxsat etilgan originlar
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- Tashqi servislar
TELEGRAM_BOT_TOKEN=
SMTP_URL=
SENTRY_DSN=
