# This file is committed and contains KEY NAMES and placeholders only.
# Real values live in .env, which is git-ignored.
#
#   cp .env.example .env
#
# When you add a variable, add it HERE too — `make doctor` and CI both verify
# that the two files declare the same keys.

# ---------------------------------------------------------------- Application
APP_NAME=project
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=debug

# ---------------------------------------------------------------- Docker Compose
# docker-compose.yml reads these
COMPOSE_PROJECT_NAME=project
POSTGRES_DB=app_db
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------- Database
# From the host machine (local dev server, migrations, psql):
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/app_db
# From inside a container the host is `postgres`, not `localhost`:
# DATABASE_URL=postgresql://app:app_dev_password@postgres:5432/app_db

# ---------------------------------------------------------------- Queue / cache
# Started by `make dev-queue`. From inside a container: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Security
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- Third-party services
TELEGRAM_BOT_TOKEN=
SMTP_URL=
SENTRY_DSN=
